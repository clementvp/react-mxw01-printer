{
  "name": "react-mxw01-printer",
  "version": "0.1.0",
  "description": "React hooks and utilities for MXW01 thermal printer via Web Bluetooth API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "keywords": [
    "react",
    "thermal-printer",
    "mxw01",
    "bluetooth",
    "web-bluetooth",
    "printer",
    "hooks"
  ],
  "author": "clément van peuter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clementvp/react-mxw01-printer"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.3.0"
  }
}
